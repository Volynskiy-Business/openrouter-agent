  "license": "MIT",
  "dependencies": {
    "@openrouter/agent": "^0.1.0",
    "chalk": "^5.3.0",
    "dotenv": "^16.4.0",
    "eventemitter3": "^5.0.0",
    "ink": "^5.1.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "react": "^18.3.1",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
