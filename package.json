{
  "name": "openrouter-agent",
  "version": "1.0.0",
  "description": "Multi-agent AI orchestrator with OpenRouter Agent SDK — config-driven routing, policy guardrails, audit ledger, and frontend track",
  "type": "module",
  "main": "dist/cli/index.js",
  "scripts": {
    "start": "tsx src/cli/index.tsx",
    "start:plain": "tsx src/cli/index.tsx --plain",
    "dev": "tsx watch src/cli/index.tsx",
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "openrouter",
    "ai-agent",
    "orchestrator",
    "multi-agent",
    "llm"
  ],
