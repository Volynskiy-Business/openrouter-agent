# OpenRouter API Key — get yours at https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Budget mode: strict | balanced | max_quality
BUDGET_MODE=strict

# Daily budget limit in USD (0 = unlimited for free models)
BUDGET_LIMIT_DAILY_USD=0

# Dry-run mode: true = show plan without executing
DRY_RUN=false

# Project workspace directory (default: current directory)
# WORKSPACE_DIR=/opt/projects/my-project
